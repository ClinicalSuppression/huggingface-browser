{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "electron/**/*",
    "src/adapters/**/*",
    "src/core/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "test/**/*",
    "src/**/*.test.ts",
    "src/ui/**/*",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
