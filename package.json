{
  "name": "huggingface-browser",
  "version": "0.1.1",
  "description": "Windows 11 desktop model browser and local serving orchestrator for Hugging Face, Ollama, llama.cpp, xollama, and vLLM.",
  "main": "dist-electron/electron/main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package": "electron-builder"
  },
  "keywords": [
    "huggingface",
    "ollama",
    "llama.cpp",
    "xollama",
    "vllm",
    "gguf",
    "safetensors",
    "ai",
    "llm",
    "windows-11"
  ],
  "author": "ClinicalSuppression",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0"
  }
}
